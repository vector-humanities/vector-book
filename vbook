def die(msg):
    sys.exit(f"vbook: {msg}")


def merge(base, over):
    out = dict(base)
    for k, v in (over or {}).items():
        out[k] = merge(base[k], v) if isinstance(base.get(k), dict) and isinstance(v, dict) else v
    return out


def load(root, template=None):
    p = root / "book.toml"
    if not p.exists():
        die(f"no book.toml in {root}")
    with open(p, "rb") as f:
        raw = tomllib.load(f)
    if template:
        # another template's sample: its own page and fonts, not this book's overrides
        raw.setdefault("design", {}).update(template=template, page={}, fonts={})
        if "cover" in TEMPLATE_DEFAULTS.get(template, {}):
            raw["design"]["cover"] = TEMPLATE_DEFAULTS[template]["cover"]
    cfg = merge(DEFAULTS, raw)
    tpl = cfg["design"]["template"]
    if tpl not in TEMPLATE_DEFAULTS:
        die(f"unknown template {tpl!r}; have {', '.join(TEMPLATE_DEFAULTS)}")
    td = TEMPLATE_DEFAULTS[tpl]
    page = {k: cfg["design"]["page"].get(k, td[k]) for k in ("width", "height", "inside", "outside", "top", "bottom", "size")}
    for k, v in page.items():
        if not LENGTH.match(str(v)):
            die(f"design.page.{k} = {v!r} is not a length such as 156mm or 10.5pt")
    cfg["_page"] = page
    if not cfg["design"]["cover"]:
        cfg["design"]["cover"] = td.get("cover", "frame")
    if cfg["imprint"]["series-style"] not in ("roman", "italic", "caps"):
        die('imprint.series-style should be "roman", "italic" or "caps"')
    for k in ("isbn", "doi", "licence"):          # first placed in [book]; they belong to the imprint page
        if cfg["book"].get(k) and not cfg["imprint"].get(k):
            cfg["imprint"][k] = cfg["book"][k]
    if cfg["design"]["notes"] not in ("chapter", "book"):
        die('design.notes should be "chapter" or "book"')
    cfg["_fonts"] = {k: cfg["design"]["fonts"].get(k, td[k]) for k in ("text", "mono")}
    return cfg


def run(cmd, **kw):
    try:
        return subprocess.run(cmd, check=True, text=True, capture_output=True, **kw)
    except FileNotFoundError:
        die(f"{cmd[0]} not found; install it (see README)")
    except subprocess.CalledProcessError as e:
        sys.stderr.write(e.stderr or "")
        die(f"{' '.join(map(str, cmd[:2]))} failed")


# ---- sources

def files(root, patterns):
    out = []
    for pat in patterns:
        hits = sorted(glob.glob(str(root / pat)))
        out += [Path(h) for h in hits if Path(h).is_file()]
    return out


def markers(text, cfg):
    """[p. N] to margin numbers; strip patterns removed; markers dropped inside note definitions."""
    page = re.compile(cfg["markers"]["page"] + r"[ \t]?")
    strips = [re.compile(s + r"[ \t]?") for s in cfg["markers"]["strip"]]
    code = re.compile(r"(`+).+?\1")

    def outside_code(line, fn):
        out, pos = [], 0
        for m in code.finditer(line):
            out += [fn(line[pos:m.start()]), m.group(0)]
            pos = m.end()
        return "".join(out + [fn(line[pos:])])

    def sub(seg, note):
        for s in strips:
            seg = s.sub("", seg)
        return page.sub("" if note else (lambda m: f'`#pm("{m.group(1)}")`{{=typst}}'), seg)

    lines, fenced = [], False
    for line in text.split("\n"):
        if re.match(r"^(```|~~~)", line):
            fenced = not fenced
        if not fenced:
            note = bool(re.match(r"^\[\^[^\]]+\]:", line))
            line = outside_code(line, lambda seg: sub(seg, note))
        lines.append(line)
    return "\n".join(lines)


def glossary(root, cfg):
    src = cfg["sources"]
    if not src["glossary"]:
        return ""
    cols, heads = src["glossary-columns"], src["glossary-headers"]
    with open(root / src["glossary"], encoding="utf-8", newline="") as f:
        rows = list(csv.DictReader(f))
    esc = lambda s: (s or "").replace("|", "\\|").replace("\n", " ").strip()
    out = [f"# {src['glossary-title']}", "", "| " + " | ".join(heads) + " |", "|" + "---|" * len(heads)]
    out += ["| " + " | ".join(esc(r.get(c)) for c in cols) + " |" for r in rows]
    return "\n".join(out) + "\n"


def sources(root, cfg):
    s = cfg["sources"]
    return files(root, s["front"]) + files(root, s["body"]) + files(root, s["back"])


def assemble(root, cfg):
    fs = sources(root, cfg)
    if not fs:
        die("no source files; set sources.body in book.toml")
    chunks = [WORKING.sub("", f.read_text(encoding="utf-8")).strip() for f in fs]
    md = "\n\n".join(markers(c, cfg) for c in chunks) + "\n\n" + glossary(root, cfg)
    return md, fs


# ---- Typst values

def md2ty(md):
    if md is None or not str(md).strip():
        return "none"
    out = run(["pandoc", "-f", "markdown-auto_identifiers", "-t", "typst", "--wrap=none"], input=str(md)).stdout.strip()
    return "[" + out + "]"


def plain(md):
    return re.sub(r"[*_`]", "", md or "")


def tystr(s):
    return json.dumps(str(s), ensure_ascii=False)


def colour(c):
    if not re.match(r"^#[0-9a-fA-F]{6}$", c or ""):
        die(f"colour {c!r} should be #rrggbb")
    return f'rgb("{c}")'


def image_dict(d, root, what):
    if not d:
        return "none"
    img = d.get("image")
    if not img or not (root / img).exists():
        die(f"{what}: image {img!r} not found")
    w = d.get("width", "56mm")
    if not LENGTH.match(w):
        die(f"{what}: width {w!r} is not a length")
    return f'(image: "/{img}", width: {w}, caption: {md2ty(d.get("caption"))})'


CJK_FACES = ("mincho", "gothic", " jp", "han", "song", "ming", "kaku")


def typeset_line(root, cfg):
    """'Typeset in … with Vector Book', naming the faces this book's characters reach."""
    md, _ = assemble(root, cfg)
    text = cfg["_fonts"]["text"]
    faces = [text[0]]
    disp = TEMPLATE_DEFAULTS[cfg["design"]["template"]].get("display")
    if disp and disp not in faces:
        faces.append(disp)
    if any("\u0370" <= c <= "\u03ff" or "\u1f00" <= c <= "\u1fff" for c in md) and "Gentium Book Plus" in text:
        faces.append("Gentium Book Plus")
    if any("\u3000" <= c <= "\u9fff" for c in md):
        faces += [f for f in text if any(k in f.lower() for k in CJK_FACES)][:1]
    names = faces[0] if len(faces) == 1 else ", ".join(faces[:-1]) + " and " + faces[-1]
    return f"Typeset in {names} with Vector Book."


VH_LOGO = '(image: "/build/.vbook/lib/assets/vector-humanities-mark.svg", width: 12mm, caption: none)'


def logo_typ(root, im):
    """The book's logo; for a Vector Humanities book with none named, the Vector Humanities mark; false for none."""
    logo = im["publisher-logo"]
    if logo is False:
        return "none"
    if logo:
        return image_dict(logo, root, "imprint.publisher-logo")
    if plain(im["publisher"] or "").strip().lower() == "vector humanities":
        return VH_LOGO
    return "none"


def imprint_typ(root, cfg):
    im = cfg["imprint"]
    isbn = im["isbn"]
    if isinstance(isbn, dict):
        isbns = [(k, v) for k, v in isbn.items()]
    else:
        isbns = [("", isbn)] if isbn else []
    typeset = im["typeset"]
    if typeset is True:
        typeset = typeset_line(root, cfg)
    lines = lambda xs: "(" + "".join(md2ty(x) + ", " for x in (xs or [])) + ")"
    fields = {
        "publisher": md2ty(im["publisher"]), "place": md2ty(im["publisher-place"]),
        "url": tystr(im["publisher-url"]) if im["publisher-url"] else "none",
        "logo": logo_typ(root, im),
        "series": md2ty(im["series"]), "series-style": tystr(im["series-style"]), "series-number": md2ty(str(im["series-number"]) if im["series-number"] else None),
        "edition": md2ty(im["edition"]), "copyright": lines(im["copyright"]), "moral-rights": md2ty(im["moral-rights"]),
        "licence": md2ty(im["licence"]), "third-party": md2ty(im["third-party"]), "ai": md2ty(im["ai"]),
        "catalogue": lines(im["catalogue"]),
        "isbn": "(" + "".join(f"({tystr(k)}, {tystr(v)}), " for k, v in isbns) + ")",
        "doi": tystr(im["doi"]) if im["doi"] else "none",
        "typeset": md2ty(typeset) if typeset else "none", "other": md2ty(im["other"]),
    }
    return "(" + ", ".join(f"{k}: {v}" for k, v in fields.items()) + ")"


def field_typ(cfg):
    """Ink and the text colour that reads on it, for the field covers."""
    sys.path.insert(0, str(HERE / "lib"))
    from fields import luminance
    ink = cfg["design"]["field-ink"]
    colour(ink)
    on = "#ffffff" if luminance(ink) < 0.4 else "#0d0d0d"
    return f'(ink: rgb("{ink}"), on-ink: rgb("{on}"))'


def meta_typ(root, cfg):
    b, d, c, bk = cfg["book"], cfg["design"], cfg["cover"], cfg["back"]
    pg = cfg["_page"]
    words = [re.escape(w) for w in d["no-hyphen"]]
    nohyphen = r"(?i)\b(" + "|".join(words) + r")\b" if words else NEVER
    frame = c.get("frame")
    frame_ty = "none" if not frame else "(" + ", ".join(f"{k}: {tystr(frame.get(k, ''))}" for k in ("left", "centre", "right")) + ")"
    fields = {
        "title": md2ty(b["title"]),
        "title-plain": tystr(plain(b["title"])),
        "subtitle": md2ty(b["subtitle"]),
        "author": md2ty(b["author"]),
        "author-plain": tystr(plain(b["author"]) or ""),
        "original-title": md2ty(b["original-title"]),
        "running-title": md2ty(b["running-title"] or b["title"]),
        "credit": md2ty(b["credit"]),
        "affiliation": md2ty(b["affiliation"]),
        "imprint": imprint_typ(root, cfg),
        "field": field_typ(cfg),
        "credits": md2ty(b["credits"]) if b["credits"] else "[]",
        "lang": tystr(b["lang"]),
        "region": tystr(b["region"]),
        "page": "(" + ", ".join(f"{k}: {v}" for k, v in pg.items()) + ")",
        "fonts": "(" + ", ".join(f"{k}: (" + ", ".join(tystr(x) for x in v) + ",)" for k, v in cfg["_fonts"].items()) + ")",
        "nohyphen": tystr(nohyphen),
        "end-blanks": str(int(d["end-blanks"])),
        "notes-reset": "true" if d["notes"] == "chapter" else "false",
        "frontispiece": image_dict(cfg["frontispiece"], root, "frontispiece"),
        "cover": f"(paper: {colour(c['paper'])}, ink: {colour(c['ink'])}, accent: {colour(c['accent'])}, frame: {frame_ty})",
        "back": "(" + ", ".join([
            f"portrait: {image_dict(bk.get('portrait'), root, 'back.portrait')}",
            f"quote: {md2ty(bk.get('quote'))}",
            f"quote-source: {md2ty(bk.get('quote-source'))}",
            f"blurb: {md2ty(bk.get('blurb'))}"]) + ")",
    }
    return "#let meta = (\n" + "".join(f"  {k}: {v},\n" for k, v in fields.items()) + ")\n"


# ---- build

def textwidth_mm(pg):
    def mm(v):
        n, u = re.match(r"^(-?[\d.]+)(\w+)$", v).groups()
        return float(n) * {"mm": 1, "cm": 10, "pt": 0.3528, "in": 25.4, "em": 3.7}[u]
    return mm(pg["width"]) - mm(pg["inside"]) - mm(pg["outside"])


def stage(root, cfg):
    """Copy the library into build/.vbook so that Typst's root (the project) holds everything."""
    bd = root / "build"
    lib = bd / ".vbook"
    if lib.exists():
        shutil.rmtree(lib)
    for sub in ("lib", "templates", "covers"):
        shutil.copytree(HERE / sub, lib / sub)
    cover = cfg["design"]["cover"]
    if not (HERE / "covers" / f"{cover}.typ").exists():
        die(f"unknown cover {cover!r}")
    return bd


# colours for the wildcard's fields: each chapter's field takes the next colour in turn
FIELD_PALETTES = {
    "mint-pink": ["#bfe6d4", "#f4c4d3"],
    "acid": ["#dcf25c", "#a9ecff"],
    "sand-sky": ["#efdcb4", "#bcd8f0"],
    "coral": ["#ffb199", "#ffe08a"],
    "electric": ["#b3b8ff", "#ffc2b5"],
    "mono": [],
}


def field_colours(cfg):
    d = cfg["design"]
    cols = d["field-colours"]
    if cols is None:
        if d["field-palette"] not in FIELD_PALETTES:
            die(f"design.field-palette {d['field-palette']!r}: one of {', '.join(FIELD_PALETTES)}")
        cols = FIELD_PALETTES[d["field-palette"]]
    for c in cols + [d["field-ink"]]:
        colour(c)
    return cols


def cover_title_mm(root, cfg, width_mm):
    """Height in mm of the field cover's stacked title, measured by Typst with the cover's settings."""
    title = tystr(plain(cfg["book"]["title"]))
    lang = tystr(cfg["book"]["lang"])
    src = root / "build" / "measure.typ"
    src.write_text(f"""#set page(width: {width_mm}mm, height: 400mm, margin: (x: 10mm))
#set text(lang: {lang})
#context {{
  let b = block(width: {width_mm - 20}mm, {{
    set par(leading: 0.06em)
    set text(hyphenate: true)
    text(58pt, font: ("Archivo", "Fira Sans"), tracking: -0.02em, upper({title}))
  }})
  [#metadata(measure(b).height.mm()) <vb-title-height>]
}}
""", encoding="utf-8")
    r = run(["typst", "eval", *typst_args(root), "query(<vb-title-height>).first().value", "--in", str(src)])
    return float(r.stdout.strip())


def make_fields(root, cfg, md):
    """Generated field pages and cover for the wildcard template and the field cover."""
    td = TEMPLATE_DEFAULTS[cfg["design"]["template"]]
    if not td.get("fields") and cfg["design"]["cover"] != "field":
        return
    sys.path.insert(0, str(HERE / "lib"))
    from fields import field_svg
    fd = root / "build" / "fields"
    fd.mkdir(parents=True, exist_ok=True)
    pg = cfg["_page"]
    mm = lambda v: float(re.match(r"^([\d.]+)mm$", v).group(1)) if v.endswith("mm") else 156.0
    w, h = mm(pg["width"]), mm(pg["height"])
    colours = field_colours(cfg) or [None]
    ink = cfg["design"]["field-ink"]
    title = plain(cfg["book"]["title"])
    # keep ink out from behind the cover's title: set the title as the cover sets it, measure its height,
    # and clear from the top of the page to below it
    clear = (0, 0, w, 14 + cover_title_mm(root, cfg, w) + 8)
    (fd / "cover.svg").write_text(field_svg(title + "/cover", w, h, colour=colours[0], ink=ink, black=0.6, clear=clear),
                                  encoding="utf-8")
    if td.get("fields"):
        level = max(1, 1 - int(cfg["sources"]["shift-headings"]))
        n = len(re.findall(r"^#{%d} \S" % level, md, re.M)) + 3
        for i in range(n):
            for k in (1, 2, 3):
                colour = colours[(i + k) % len(colours)] if k != 2 else None
                (fd / f"field-{i}-{k}.svg").write_text(
                    field_svg(f"{title}/{i}/{k}", w, h, colour=colour, ink=ink), encoding="utf-8")


def typst_args(root):
    args = ["--root", str(root)]
    if (root / "fonts").is_dir():
        args += ["--font-path", str(root / "fonts")]
    return args


def main_typ(cfg):
    tpl, cover = cfg["design"]["template"], cfg["design"]["cover"]
    return f"""// generated by vbook: do not edit
#import "/build/.vbook/templates/{tpl}.typ": *
#import "/build/.vbook/covers/{cover}.typ" as cover
#import "/build/meta.typ": meta
#show: book.with(meta)
#cover.front(meta)
#frontispiece(meta)
#title-page(meta)
#credits-page(meta)
#contents(meta)
#include "/build/body.typ"
#blank-pages(meta.end-blanks)
#cover.back(meta)
"""


def build(root, quiet=False, template=None, output=None):
    cfg = load(root, template)
    md, fs = assemble(root, cfg)
    bd = stage(root, cfg)
    make_fields(root, cfg, md)
    (bd / "body.md").write_text(md, encoding="utf-8")
    s = cfg["sources"]
    cmd = ["pandoc", str(bd / "body.md"), "-f", "markdown+raw_attribute+footnotes+pipe_tables",
           "-t", "typst", "--wrap=preserve", "--lua-filter", str(bd / ".vbook/lib/vbook.lua"),
           "-M", f"vbook-root={root}", "-M", f"vbook-dpi={cfg['design']['figure-dpi']}",
           "-M", f"vbook-textwidth={textwidth_mm(cfg['_page']):.1f}",
           "-M", f"vbook-parse-headings={'true' if s['parse-headings'] else 'false'}",
           "-M", f"vbook-shift={int(s['shift-headings'])}",
           "-M", f"vbook-overlays={root / s['overlays']}", "-o", str(bd / "body.typ")]
    if s["bibliography"]:
        cmd += ["--citeproc", "--bibliography", str(root / s["bibliography"])]
        if s["csl"]:
            cmd += ["--csl", str(root / s["csl"])]
    run(cmd)
    body = (bd / "body.typ").read_text(encoding="utf-8")
    tpl = cfg["design"]["template"]
    (bd / "body.typ").write_text(f'#import "/build/.vbook/templates/{tpl}.typ": *\n' + body, encoding="utf-8")
    (bd / "meta.typ").write_text(meta_typ(root, cfg), encoding="utf-8")
    (bd / "main.typ").write_text(main_typ(cfg), encoding="utf-8")
    out = root / (output or cfg["book"]["output"])
    out.parent.mkdir(parents=True, exist_ok=True)
    r = run(["typst", "compile", *typst_args(root), str(bd / "main.typ"), str(out)])
    if r.stderr.strip():
        sys.stderr.write(r.stderr)
    if not quiet:
        print(f"built {out.relative_to(root)} from {len(fs)} files")
    return cfg, out


# ---- checks

def pdffonts(pdf, page=None):
    cmd = ["pdffonts"] + (["-f", str(page), "-l", str(page)] if page else []) + [str(pdf)]
    lines = run(cmd).stdout.splitlines()[2:]
    return [l.split()[0].split("+")[-1] for l in lines if l.strip()]


def count(root, selector):
    r = run(["typst", "eval", *typst_args(root), f"query({selector}).len()", "--in", str(root / "build/main.typ")])
    return int(r.stdout.strip())


def pages(pdf):
    m = re.search(r"^Pages:\s+(\d+)", run(["pdfinfo", str(pdf)]).stdout, re.M)
    return int(m.group(1)) if m else 0


CAPTION_WORDS = 20


def unkeyed_captions(md):
    """Figure captions long enough to want a key, but with no marker to split one off."""
    caps = [(m.group(1), m.group(2)) for m in re.finditer(r"^\*\*(Figure \d+)\.\*\*(.*)$", md, re.M)]
    caps += [(m.group(1)[:30], m.group(1)) for m in re.finditer(r"^!\[([^\]]+)\]\([^)]+\)", md, re.M)]
    out = []
    for name, text in caps:
        if re.search(r"\b(Labels|Key):", text):
            continue
        words = re.sub(r"\[\^[^\]]+\]|[*_`]", "", text).split()
        if len(words) > CAPTION_WORDS:
            out.append(name)
    return out


def tool_version():
    try:
        r = subprocess.run(["git", "-C", str(HERE), "describe", "--always", "--dirty"], text=True, capture_output=True)
        return r.stdout.strip() or "unknown"
    except FileNotFoundError:
        return "unknown"


def cmd_check(root, report=False):
    cfg, out = build(root)
    md, fs = assemble(root, cfg)
    src_notes = len(re.findall(r"^\[\^[^\]]+\]:", md, re.M))
    src_figs = len(re.findall(r"^!\[[^\]]*\]\([^)]+\)", md, re.M))
    notes = count(root, "footnote")
    figs = count(root, "figure.where(kind: image)")
    missing = [f for f in set(pdffonts(out)) if "LastResort" in f]
    long_caps = unkeyed_captions(md)
    lines = [f"pages    {pages(out)}",
             f"notes    {notes} set, {src_notes} defined in the sources" + ("" if notes >= src_notes else "  << notes lost"),
             f"figures  {figs} set, {src_figs} in the sources" + ("" if figs == src_figs else "  << check figures"),
             "glyphs   " + ("no missing glyphs" if not missing else "MISSING GLYPHS: run vbook sweep")]
    if long_caps:
        lines.append(f"captions {len(long_caps)} over {CAPTION_WORDS} words with no \"Labels:\" or \"Key:\", "
                     "set whole in the List of Figures: " + ", ".join(long_caps))
    print("\n".join(lines))
    failed = bool(missing or notes < src_notes or figs != src_figs)
    if report:
        import datetime
        rp = out.parent / "BUILD.md"
        rp.write_text(
            f"# Build report\n\n"
            f"- Built: {datetime.datetime.now().strftime('%Y-%m-%d %H:%M')}\n"
            f"- Output: `{out.relative_to(root)}`\n"
            f"- Vector Book: {tool_version()}; template `{cfg['design']['template']}`, cover `{cfg['design']['cover']}`\n"
            f"- Sources: {len(fs)} files\n"
            f"- Result: {'FAILED' if failed else 'passed'}\n\n"
            "```\n" + "\n".join(lines) + "\n```\n\n"
            "Files, in order:\n\n" + "".join(f"- `{f.relative_to(root)}`\n" for f in fs), encoding="utf-8")
        print(f"report   {rp.relative_to(root)}")
    return 1 if failed else 0


ALIASES = {"hiraginominchopron": "hiraminpron", "hiraginominchopro": "hiraminpro", "hiraginosans": "hiraginosans",
           "hiraginokakugothicpron": "hirakakupron", "shipporimincho": "shipporimincho",
           "applesymbols": "applesymbols", "stixtwotext": "stixtwotext", "stixtwomath": "stixtwomath"}


def sweep(root, cfg):
    """Set every distinct non-ASCII character on test pages; return (chars, groups, problems)."""
    md, _ = assemble(root, cfg)
    text = md + json.dumps(cfg, ensure_ascii=False)
    chars = sorted({c for c in text if ord(c) > 127 and unicodedata.category(c)[0] not in "CZ"})
    groups, cur, key = [], [], None
    for c in chars:
        k = ord(c) >> 7
        if cur and (k != key or len(cur) >= 32):
            groups.append(cur); cur = []
        cur.append(c); key = k
    if cur:
        groups.append(cur)
    bd = stage(root, cfg)
    (bd / "meta.typ").write_text(meta_typ(root, cfg), encoding="utf-8")
    tpl = cfg["design"]["template"]
    pages_src = []
    for g in groups:
        label = f"U+{ord(g[0]):04X} {unicodedata.name(g[0], '?').title()}"
        cells = ", ".join(tystr(c) for c in g)
        pages_src.append(f"#page[#text(7pt, font: \"STIX Two Text\")[{label}]\n\n"
                         f"#grid(columns: 8, gutter: 6pt, ..({cells},).map(c => text(16pt, c)))]")
    (bd / "sweep.typ").write_text(
        f'#import "/build/.vbook/templates/{tpl}.typ": *\n#import "/build/meta.typ": meta\n'
        f'#show: book.with(meta)\n#set page(header: none, footer: none)\n' + "\n".join(pages_src), encoding="utf-8")
    pdf = bd / "sweep.pdf"
    run(["typst", "compile", *typst_args(root), str(bd / "sweep.typ"), str(pdf)])
    stack = [re.sub(r"\W", "", f).lower() for f in cfg["_fonts"]["text"]] + ["stixtwotext"]
    stack = [ALIASES.get(s, s) for s in stack]
    problems = []
    for i, g in enumerate(groups, 1):
        used = set(pdffonts(pdf, i))
        missing = [f for f in used if "LastResort" in f]
        outside = [f for f in used if f not in missing and not any(re.sub(r"\W", "", f).lower().startswith(s[:10]) for s in stack)]
        if missing or outside:
            problems.append(("MISSING" if missing else "fallback", g, sorted(used)))
    return chars, groups, problems


def cmd_sweep(root):
    chars, groups, problems = sweep(root, load(root))
    print(f"{len(chars)} distinct non-ASCII characters on {len(groups)} pages")
    for flag, g, used in problems:
        print(f"  {flag:8} {''.join(g)}  fonts: {', '.join(used)}")
    print("clean" if not problems else f"{len(problems)} page(s) need attention: add a font to design.fonts.text")
    return 1 if problems else 0


# ---- returns to the translation side (docs/handover.md, Returns)

def located_lines(root, cfg):
    """(file, line number, source page, text) for every line the book reads, working blocks excluded."""
    page = re.compile(cfg["markers"]["page"])
    for f in sources(root, cfg):
        p, working = None, False
        for n, line in enumerate(f.read_text(encoding="utf-8").split("\n"), 1):
            if "<!-- working -->" in line:
                working = True
            if not working:
                for m in page.finditer(line):
                    p = m.group(1)
                yield f.relative_to(root), n, p, line
            if "<!-- /working -->" in line:
                working = False


def where(f, n, p):
    return f"`{f}:{n}`" + (f", after [p. {p}]" if p else ", before the first page marker")


def findings(root, cfg):
    """Faults a check can locate in the sources: (kind, title, where, evidence)."""
    out = []
    lines = list(located_lines(root, cfg))
    defs, refs = {}, {}
    heads = {}
    for f, n, p, line in lines:
        m = re.match(r"^\[\^([^\]]+)\]:", line)
        if m:
            defs.setdefault(m.group(1), []).append((f, n, p))
        for r in re.finditer(r"\[\^([^\]]+)\](?!:)", line[m.end():] if m else line):
            refs.setdefault(r.group(1), []).append((f, n, p))
        if re.match(r"^# \S", line):
            heads.setdefault(f, []).append(n)
        cap = re.match(r"^\*\*(Figure \d+)\.\*\*(.*)$", line)
        if cap and not re.search(r"\b(Labels|Key):", cap.group(2)):
            words = re.sub(r"\[\^[^\]]+\]|[*_`]", "", cap.group(2)).split()
            if len(words) > CAPTION_WORDS:
                out.append(("MARKUP", f"{cap.group(1)}: long caption with no key marker", where(f, n, p),
                            f"{len(words)} words with no \"Key:\" or \"Labels:\"; the whole caption is set in the List of Figures. "
                            "Add \"Key: \" where the key begins, or confirm it is all caption."))
        img = re.match(r"^!\[[^\]]*\]\(([^)\s]+)", line)
        if img and not (root / img.group(1)).exists():
            out.append(("SOURCES", f"Figure image not found: {img.group(1)}", where(f, n, p),
                        "The image line names a file that is not in the book folder."))
    for label, ds in defs.items():
        if len(ds) > 1:
            out.append(("MARKUP", f"Note label defined {len(ds)} times: [^{label}]", "; ".join(where(*d) for d in ds),
                        "Labels must be unique across the book; Pandoc keeps one definition and the other note is lost."))
        if label not in refs:
            out.append(("MARKUP", f"Note defined but not referenced: [^{label}]", where(*ds[0]),
                        "No [^" + label + "] in the text; Pandoc drops the note."))
    for label, rs in refs.items():
        if label not in defs:
            out.append(("MARKUP", f"Note referenced but not defined: [^{label}]", where(*rs[0]),
                        "The reference is set as literal text."))
    for f, ns in heads.items():
        if len(ns) > 1:
            out.append(("MARKUP", f"{len(ns)} level-one headings in one file", ", ".join(f"`{f}:{n}`" for n in ns),
                        "At most one level-one heading per section file; split the file or make the later headings level two."))
    return out, lines


def next_return(root):
    pd = root / "proof"
    pd.mkdir(exist_ok=True)
    nums = [int(m.group(1)) for p in pd.glob("return-*.md") if (m := re.match(r"return-(\d+)\.md$", p.name))]
    return pd / f"return-{(max(nums) + 1 if nums else 1):02d}.md", (max(nums) + 1 if nums else 1)


def cmd_return(root):
    import datetime
    code = cmd_check(root, report=True)
    cfg = load(root)
    out, lines = findings(root, cfg)
    _, _, problems = sweep(root, cfg)
    for flag, g, used in problems:
        at = {}
        for c in g:
            hit = next(((f, n, p) for f, n, p, line in lines if c in line), None)
            if hit:
                at.setdefault(hit, []).append(c)
        locs = [f"{''.join(cs)} first at {where(*h)}" for h, cs in at.items()]
        out.append(("LAYOUT", f"{'Missing glyphs' if flag == 'MISSING' else 'Font fallback'}: {''.join(g)}",
                    "; ".join(locs) or "(not found in the sources: book.toml text)",
                    f"Set in {', '.join(used)}. A font for these characters goes in design.fonts.text. No action for the translation side."))
    path, num = next_return(root)
    rows = [("Book", root.name), ("Round", f"{num:02d}"), ("Date", datetime.date.today().isoformat()),
            ("Vector Book", tool_version()), ("Build", f"{'FAILED' if code else 'passed'} (`{Path(cfg['book']['output']).parent}/BUILD.md`)"),
            ("Handover", cfg["sources"]["handover"]), ("Status", "OPEN")]
    md = [f"# Return {num:02d}: {plain(cfg['book']['title'])}", "", "| | |", "|---|---|"]
    md += [f"| {k} | {v} |" for k, v in rows]
    md += ["", "Kinds: MARKUP, TEXT, QUERY, SOURCES, LAYOUT, OTHER. Responses: FIXED, CHANGED-OTHERWISE, QUERY-TO-TRANSLATOR, "
           "DECLINED, NOTED. Format and rules: Vector Book `docs/handover.md`, Returns.", ""]
    if not out:
        md += ["No faults found by `vbook check` and `vbook sweep`. Items from proof are added below by hand, from R1.", ""]
    for i, (kind, title, loc, ev) in enumerate(out, 1):
        md += [f"## R{i} · {kind} · {title}", "", f"- Where: {loc}", "- Found by: vbook return", f"- Evidence: {ev}",
               "- Proposed:", "- Response:", "- Book side:", ""]
    path.write_text("\n".join(md), encoding="utf-8")
    print(f"{path.relative_to(root)}: {len(out)} item(s) from the checks; add proof items by hand")


def cmd_proof(root, sel):
    cfg, out = build(root, quiet=True)
    bd = root / "build" / "proof"
    if bd.exists():
        shutil.rmtree(bd)
    bd.mkdir(parents=True)
    args = ["typst", "compile", *typst_args(root), "--format", "png", "--ppi", "36"]
    if sel:
        args += ["--pages", sel]
    run(args + [str(root / "build/main.typ"), str(bd / "p-{0p}.png")])
    imgs = sorted(bd.glob("p-*.png"))
    cells = ", ".join(f'box(stroke: 0.4pt + luma(150), image("/build/proof/{p.name}"))' for p in imgs)
    (bd / "sheet.typ").write_text(
        f"#set page(width: 1600pt, height: auto, margin: 12pt, fill: luma(225))\n"
        f"#grid(columns: 10, gutter: 8pt, {cells})\n", encoding="utf-8")
    run(["typst", "compile", "--root", str(root), "--format", "png", "--ppi", "72",
         str(bd / "sheet.typ"), str(root / "build/proof.png")])
    print(f"build/proof.png: {len(imgs)} pages")


def evaluate(root, expr):
    r = run(["typst", "eval", *typst_args(root), expr, "--in", str(root / "build/main.typ")])
    return json.loads(r.stdout)


def cmd_samples(root):
    names = sorted(p.stem for p in (HERE / "templates").glob("*.typ"))
    sd = root / "build" / "samples"
    if sd.exists():
        shutil.rmtree(sd)
    rows = []
    for name in names:
        build(root, quiet=True, template=name, output=f"build/samples/{name}.pdf")
        chapters = evaluate(root, "query(heading.where(level: 1)).map(h => h.location().page())")
        numbered = evaluate(root, "query(heading.where(level: 1)).filter(h => h.outlined and h.supplement != []).map(h => h.location().page())")
        figures = evaluate(root, "query(figure.where(kind: image)).map(f => f.location().page())")
        first = numbered[0] if numbered else next((p for p in chapters if p > 5), chapters[0] if chapters else 1)
        pick = [3, first, first + 1] + figures[:1] + chapters[-1:]
        pick = sorted(set(pick), key=pick.index)
        run(["typst", "compile", *typst_args(root), "--format", "png", "--ppi", "60",
             "--pages", ",".join(map(str, pick)), str(root / "build/main.typ"), str(sd / f"{name}-{{0p}}.png")])
        imgs = sorted(sd.glob(f"{name}-*.png"))
        rows.append((name, imgs))
        print(f"build/samples/{name}.pdf: pages {', '.join(map(str, pick))}")
    cells = []
    for name, imgs in rows:
        cells.append(f'text(14pt, font: "STIX Two Text", upper("{name}"))')
        cells.append("stack(dir: ltr, spacing: 10pt, " + ", ".join(
            f'box(stroke: 0.4pt + luma(150), image("/build/samples/{p.name}", width: 156pt))' for p in imgs) + ")")
    (sd / "sheet.typ").write_text(
        "#set page(width: auto, height: auto, margin: 16pt, fill: luma(228))\n"
        "#stack(spacing: 12pt, " + ", ".join(cells) + ")\n", encoding="utf-8")
    run(["typst", "compile", "--root", str(root), "--format", "png", "--ppi", "72",
         str(sd / "sheet.typ"), str(root / "build/samples.png")])
    build(root, quiet=True)
    print("build/samples.png")


def cmd_fonts(root):
    cfg = load(root) if (root / "book.toml").exists() else None
    have = set(run(["typst", "fonts", *(["--font-path", str(root / "fonts")] if (root / "fonts").is_dir() else [])]).stdout.splitlines())
    stacks = cfg["_fonts"] if cfg else {k: v for k, v in TEMPLATE_DEFAULTS["classic"].items() if k in ("text", "mono")}
    for k, stack in stacks.items():
        print(k)
        for f in stack:
            print(f"  {'ok     ' if f in have else 'MISSING'} {f}")


def cmd_new(dest):
    if dest.exists() and any(dest.iterdir()):
        die(f"{dest} exists and is not empty")
    shutil.copytree(HERE / "starter", dest, dirs_exist_ok=True)
    print(f"started {dest}; edit book.toml, then: vbook build {dest}")


def main():
    ap = argparse.ArgumentParser(prog="vbook", description=__doc__.split("\n")[0])
    ap.add_argument("command", choices=["new", "build", "check", "sweep", "proof", "samples", "return", "fonts"])
    ap.add_argument("dir", nargs="?", default=".")
    ap.add_argument("--pages", help="for proof: pages to include, as typst --pages takes them (e.g. 1-12,40)")
    ap.add_argument("--report", action="store_true", help="for check: also write BUILD.md beside the PDF")
    a = ap.parse_args()
    root = Path(a.dir).resolve()
    if a.command == "new":
        cmd_new(root)
    elif a.command == "build":
        build(root)
    elif a.command == "check":
        sys.exit(cmd_check(root, a.report))
    elif a.command == "sweep":
        sys.exit(cmd_sweep(root))
    elif a.command == "proof":
        cmd_proof(root, a.pages)
    elif a.command == "return":
        cmd_return(root)
    elif a.command == "samples":
        cmd_samples(root)
    elif a.command == "fonts":
        cmd_fonts(root)


if __name__ == "__main__":
    main()
